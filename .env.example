# ============================================================
# HRMS Pro – Environment Configuration Template
# ============================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/hrms_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Security
JWT_SECRET=hrmsProSuperSecretKeyForJWTTokenGenerationMustBe256BitsLongAtLeast2024
JWT_EXPIRATION_MS=86400000

# File Storage
FILE_UPLOAD_DIR=./uploads
FILE_MAX_SIZE=10485760

# Allowed CORS Origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500
